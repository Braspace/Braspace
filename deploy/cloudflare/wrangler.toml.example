# Example config for the MoonProof Worker (static web/ + same-origin API proxy).
# Copy to wrangler.toml in this directory and set `name` to the Worker that serves
# https://braspace-moonproof.<account>.workers.dev. No secrets are needed: the upstream
# API origin is pinned in moonproof-worker.mjs.
name = "braspace-moonproof"
main = "moonproof-worker.mjs"
compatibility_date = "2026-11-01"

[assets]
directory = "../../web"
binding = "ASSETS"
# Run the Worker first for /api/*, /v1/*, /healthz and /readyz; everything else is served from ASSETS.
run_worker_first = ["/api/*", "/v1/*", "/healthz", "/readyz"]
