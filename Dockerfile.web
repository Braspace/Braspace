# Hardened Node runtime for same-origin MoonProof + Go API proxy.
FROM node:22-alpine
ENV NODE_ENV=production BRASPACE_WEB_HOST=0.0.0.0 BRASPACE_WEB_PORT=5173 BRASPACE_API_HOST=api BRASPACE_API_PORT=8080
WORKDIR /app
COPY --chown=node:node web/ ./web/
USER node
EXPOSE 5173
HEALTHCHECK --interval=20s --timeout=5s --start-period=15s --retries=3 CMD node -e 'fetch("http://127.0.0.1:5173/moonproof/").then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))'
CMD ["node","web/dev-server.mjs"]
